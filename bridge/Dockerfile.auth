FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    xvfb x11vnc novnc websockify openbox \
    chromium curl \
    && rm -rf /var/lib/apt/lists/*

RUN pip install playwright && playwright install-deps chromium && playwright install chromium

COPY . /app
WORKDIR /app
RUN pip install -r requirements.txt

# Пароль VNC
RUN mkdir -p /root/.vnc && x11vnc -storepasswd password /root/.vnc/passwd

# Скрипт запуска VNC + браузера
COPY start-auth.sh /app/start-auth.sh
RUN chmod +x /app/start-auth.sh
CMD ["/app/start-auth.sh"]